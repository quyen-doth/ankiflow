# =============================================
# REQUIRED
# =============================================

# =============================================
# FIREBASE ADMIN SDK ( gcp-service-account.json )
# =============================================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# =============================================
# FIREBASE CLIENT SDK (Client-side — public)
# =============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================
# ADMIN ACCESS
# =============================================
# Keep both email values identical. ADMIN_EMAIL enforces server-side access;
# NEXT_PUBLIC_ADMIN_EMAIL only controls admin UI visibility.
# Firestore admin access separately requires the admin:true custom claim.
ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_EMAIL=

# =============================================
# OPTIONAL
# =============================================

# =============================================
# APP BEHAVIOR
# =============================================
SIGNUP_ENABLED=false

# =============================================
# API KEYS
# =============================================
ANTHROPIC_API_KEY=
UNSPLASH_ACCESS_KEY=
# Service account JSON contents for serverless deployments (preferred)
GOOGLE_TTS_CREDENTIALS_JSON=
# Service account key file path for local development (fallback)
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================
# KNOWLEDGE HUB INTEGRATION (required only when enabled)
# =============================================
INTEGRATION_TOKEN=
INTEGRATION_TARGET_UID=

# =============================================
# LINE NOTIFICATION
# =============================================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
NEXT_PUBLIC_LINE_BOT_ID=
CRON_SECRET=

# =============================================
# PORTFOLIO CAPTURE (only for `npm run screenshots` / `npm run seed:demo`)
# =============================================
# Demo account used to sign in and seed neutral sample data when generating
# portfolio screenshots. Not required to run the app.
DEMO_EMAIL=
DEMO_PASSWORD=
